# Server
NODE_ENV=development
PORT=4000

# MongoDB — Atlas connection string (include the database name in the path)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/resume-builder?retryWrites=true&w=majority

# Gotenberg — localhost when running the container directly, http://gotenberg:3000 inside compose
# Origin allowed to call this API from a browser
# Secret used to sign session tokens (generate: openssl rand -base64 48)
JWT_SECRET=

CLIENT_URL=http://localhost:3000

GOTENBERG_URL=http://localhost:3001

# AI provider — "openai" or "gemini"
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# Points the OpenAI provider at an OpenAI-compatible service instead.
# Leave empty for OpenAI itself.
OPENAI_BASE_URL=
# Free tier key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Cloudinary (needed from the file-upload step onward)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
